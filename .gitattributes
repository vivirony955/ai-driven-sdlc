# Normalize line endings for text; leave binaries untouched.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf

# Treat office docs, archives, and images as binary (no diff/merge attempts).
*.docx  binary
*.pptx  binary
*.xlsx  binary
*.pdf   binary
*.epub  binary
*.zip   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   text

# GitHub Linguist: this is a book, not a code project.
# Keep generated/vendored material out of the language stats and diffs.
archive/**      linguist-vendored
slides/**       linguist-documentation
test-bank/**    linguist-documentation
book/**         linguist-documentation
*.md            linguist-detectable=true

# Mark large media so GitHub collapses diffs by default.
figures/*.png   -diff
