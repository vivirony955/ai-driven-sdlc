{
  "version": "0.2",
  "language": "en",
  "//": "Config for cSpell (used by the spell-check workflow). Add genuine project terms to `words` rather than disabling the check.",
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell-project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words", "en_US", "softwareTerms", "python", "node", "html", "markdown"],
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    "site/**",
    "website/site/**",
    "archive/**",
    "**/*.docx",
    "**/*.pptx",
    "**/*.png",
    "**/*.pdf",
    "**/*.zip",
    "package-lock.json",
    ".git/**"
  ],
  "words": [
    "Atlas",
    "SDLC",
    "LLM",
    "LLMs",
    "EPUB",
    "epub",
    "pandoc",
    "MkDocs",
    "mkdocs",
    "Docusaurus",
    "mdBook",
    "Jupyter",
    "LibreOffice",
    "soffice",
    "Zenodo",
    "ORCID",
    "orcid",
    "linkinator",
    "markdownlint",
    "cspell",
    "linguist",
    "frontmatter",
    "STRIDE",
    "idempotent",
    "multi-tenant",
    "tokenization",
    "subdir",
    "venv",
    "pwsh",
    "BDFL",
    "OpenSSF",
    "CNCF",
    "UNESCO",
    "OER",
    "favicon",
    "preprocess",
    "reflowable",
    "WCAG",
    "VoiceOver",
    "errata"
  ],
  "ignoreRegExpList": [
    "/\\]\\([^)]*\\)/",
    "/`[^`]+`/",
    "/https?:\\/\\/\\S+/"
  ]
}
